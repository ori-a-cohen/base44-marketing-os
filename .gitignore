# Local working notes (assignment scratch, decision drafts) — never shipped
.notes/

# Env & secrets
.env
.env.*
!.env.example

# Node / build
node_modules/
.next/
dist/
.vercel/

# Generated artifacts and runtime data (regenerated by `npm run demo`)
build/
data/cards.jsonl
data/visits.jsonl

# Test output
test-results/
playwright-report/
coverage/

# Downloaded fonts (code falls back to system fonts) and the never-committed
# Dazzed licence exception -- keep the directory's contents out of the repo
# except for the README explaining why. "assets/fonts/*" (not "assets/fonts/")
# is required for the negation below to work: gitignore never re-includes a
# path inside a directory that was itself excluded wholesale.
assets/fonts/*
!assets/fonts/README.md

# Claude Code local state
.claude/settings.local.json

# OS
.DS_Store

# SDD scratch (progress ledger)
.superpowers/

# Playwright MCP scratch output
.playwright-mcp/
