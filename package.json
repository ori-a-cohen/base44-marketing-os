{
  "name": "roundtrip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "board": "tsx src/board/server.ts",
    "lint:brand": "tsx src/lint/cli-brand.ts",
    "lint:design": "tsx src/lint/cli-design.ts",
    "measure": "tsx src/adapters/cli-measure.ts",
    "verify:page": "tsx src/verify/cli.ts",
    "demo": "bash scripts/demo.sh",
    "build:site": "tsx src/board/cli-build-site.ts",
    "deploy:board": "npm run build:site && base44 site deploy --yes"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "base44": "^0.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.40",
    "satori": "^0.12.0",
    "@resvg/resvg-js": "^2.6.2",
    "playwright": "^1.48.0",
    "yaml": "^2.6.0"
  }
}
