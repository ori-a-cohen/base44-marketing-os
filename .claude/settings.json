{
  "permissions": {
    "allow": [
      "Bash(./hooks/log-run.sh:*)",
      "Read(brand/**)",
      "Read(memory/**)",
      "Read(data/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/brand-lint.sh" }]
      }
    ]
  }
}
